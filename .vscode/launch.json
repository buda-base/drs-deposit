{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "PyRun Current File",
            "type": "node-terminal",
            "request": "launch",
            "command": "set -a; source \"${workspaceFolder}/.env\"; set +a; \"${workspaceFolder}/.venv/bin/python\" \"${file}\"",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "PyRun Current File (Prompt Args)",
            "type": "node-terminal",
            "request": "launch",
            "command": "set -a; source \"${workspaceFolder}/.env\"; set +a; \"${workspaceFolder}/.venv/bin/python\" \"${file}\" ${input:terminalArgs}",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "envFile": "${workspaceFolder}/.env",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python Debugger: Current File (Prompt Args)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "envFile": "${workspaceFolder}/.env",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "${input:debugArg1}",
                "${input:debugArg2}"
            ]
        },
        {
            "name": "Python: Attach to Container",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "127.0.0.1",
                "port": 5678
            },
            "justMyCode": true,
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "/opt/airflow"
                }
            ]
        },
        {
            "name": "Python: Attach to local",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "justMyCode": true
        }
    ],
    "inputs": [
        {
            "id": "terminalArgs",
            "type": "promptString",
            "description": "Arguments to pass to the current Python file",
            "default": "/Users/jkatz/tmp/DRS3/staging/W00KG03993 /Users/jkatz/tmp/DRS3/staging/W00KG03993/submission2.csv" 
        },
        {
            "id": "debugArg1",
            "type": "promptString",
            "description": "Python Debugger arg 1",
            "default": "/Users/jkatz/tmp/DRS3/staging/W00KG03993"
        },
        {
            "id": "debugArg2",
            "type": "promptString",
            "description": "Python Debugger arg 2",
            "default": "/Users/jkatz/tmp/DRS3/staging/W00KG03993/submission2.csv"
        }
    ]
}